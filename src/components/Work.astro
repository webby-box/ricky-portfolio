---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import voyas from '../assets/voyas.webp';
import noozz from '../assets/noozz.webp';
import gitweb from '../assets/gitweb.webp';

interface Project {
  name: string;
  code: string;
  line: string;
  image: ImageMetadata;
  alt: string;
  tone: 'lime' | 'magenta' | 'ink';
  knock: boolean;
  className: string;
  links: { href: string; label: string; sub?: boolean }[];
}

const projects: Project[] = [
  {
    name: 'Voyas AI',
    code: 'A',
    line: 'AI travel companion',
    image: voyas,
    alt: 'Voyas AI logo, a gradient letter V with a sticker outline',
    tone: 'lime',
    knock: true,
    className: 'poster-voyas',
    links: [{ href: 'https://voyas.ai', label: 'Open voyas.ai' }],
  },
  {
    name: 'Noozz AI',
    code: 'B',
    line: 'Morning intelligence brief',
    image: noozz,
    alt: 'Noozz AI logo, a geometric white N on a blue rounded square',
    tone: 'magenta',
    knock: false,
    className: 'poster-noozz',
    links: [{ href: 'https://noozz.ai', label: 'Open noozz.ai' }],
  },
  {
    name: 'gitweb',
    code: 'C',
    line: 'A GitHub repo you can see',
    image: gitweb,
    alt: 'gitweb mark: three connected nodes on a grainy dark field',
    tone: 'ink',
    knock: true,
    className: 'poster-gitweb',
    links: [
      { href: 'https://gitweb.dev', label: 'Open gitweb.dev' },
      { href: 'https://github.com/rickycheuk/gitweb', label: 'Source on GitHub', sub: true },
    ],
  },
];

const experiments = [
  {
    name: 'CoPaw',
    href: 'https://github.com/rickycheuk/CoPaw',
    body: 'A personal AI assistant you can run on your own machine or in the cloud, with extensible chat apps.',
  },
  {
    name: 'autoresearch-mlx',
    href: 'https://github.com/rickycheuk/autoresearch-mlx',
    body: 'Apple Silicon (MLX) port of Karpathy’s autoresearch — autonomous research loops on a Mac, no PyTorch.',
  },
  {
    name: 'swarm',
    href: 'https://github.com/rickycheuk/swarm',
    body: 'A small, general swarm-intelligence engine for prediction.',
  },
];
---

<section class="work" id="work">
  <h2 class="work-banner">Work</h2>
  <div class="posters">
    {projects.map((project) => (
      <article class:list={['poster', `poster-${project.tone}`, project.className]}>
        <div class="poster-top">
          <span class="poster-code">{project.code}</span>
          <div class:list={['stamp', project.knock && 'stamp-knock']}>
            <Image
              src={project.image}
              alt={project.alt}
              widths={[96, 160, 240]}
              sizes="100px"
              format="webp"
            />
          </div>
        </div>
        <h3>{project.name}</h3>
        <p class="poster-line">{project.line}</p>
        <p class="poster-go">
          {project.links.map((link) => (
            <a
              class:list={[link.sub && 'sub']}
              href={link.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              {link.label} ↗
            </a>
          ))}
        </p>
      </article>
    ))}
  </div>

  <div class="bench">
    <h3>Also on GitHub</h3>
    <p class="bench-lead">Loose prints. Same shop.</p>
    <ul class="bench-list">
      {experiments.map((item) => (
        <li>
          <a href={item.href} rel="noopener noreferrer" target="_blank">
            <strong>{item.name}</strong>
            <span>{item.body}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
