---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/outfit/wght.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title ?? 'Ricky Cheuk';
const description = Astro.props.description ?? 'Ricky Cheuk — software engineer · AI';
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const ogImage = new URL(base + 'og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1a1410" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Ricky,Ricky Cheuk,Software Engineer" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Ricky Cheuk" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@rickykccheuk" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={`${base}favicon.ico`} type="image/x-icon" sizes="16x16" />
    <link rel="icon" type="image/webp" href={`${base}favicon.webp`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  </head>
  <body>
    <slot />
  </body>
</html>
