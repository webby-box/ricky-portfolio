---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import voyas from '../assets/voyas.webp';
import noozz from '../assets/noozz.webp';
import gitweb from '../assets/gitweb.webp';

interface Project {
  name: string;
  meta: string;
  image: ImageMetadata;
  alt: string;
  body: string;
  links: { href: string; label: string }[];
}

const projects: Project[] = [
  {
    name: 'Voyas AI',
    meta: 'AI travel companion',
    image: voyas,
    alt: 'Voyas AI logo, a gradient letter V with a sticker outline',
    body: 'Personalized itineraries, local recommendations, and smart scheduling — trip planning that behaves like a companion, not a spreadsheet.',
    links: [{ href: 'https://voyas.ai', label: 'voyas.ai' }],
  },
  {
    name: 'Noozz AI',
    meta: 'Morning intelligence brief',
    image: noozz,
    alt: 'Noozz AI logo, a geometric white N on a blue rounded square',
    body: 'A personalized AI news brief for the start of the day.',
    links: [{ href: 'https://noozz.ai', label: 'noozz.ai' }],
  },
  {
    name: 'gitweb',
    meta: 'Next.js · React Flow · Framer Motion · OpenAI',
    image: gitweb,
    alt: 'gitweb mark: three connected nodes on a grainy dark field',
    body: 'Turns a GitHub repository into an interactive visual graph — the file tree, finally as a system you can actually look at.',
    links: [
      { href: 'https://gitweb.dev', label: 'gitweb.dev' },
      { href: 'https://github.com/rickycheuk/gitweb', label: 'GitHub' },
    ],
  },
];

const experiments = [
  {
    name: 'CoPaw',
    href: 'https://github.com/rickycheuk/CoPaw',
    body: 'A personal AI assistant you can run on your own machine or in the cloud, with extensible chat apps.',
  },
  {
    name: 'autoresearch-mlx',
    href: 'https://github.com/rickycheuk/autoresearch-mlx',
    body: 'Apple Silicon (MLX) port of Karpathy’s autoresearch — autonomous research loops on a Mac, no PyTorch.',
  },
  {
    name: 'swarm',
    href: 'https://github.com/rickycheuk/swarm',
    body: 'A small, general swarm-intelligence engine for prediction.',
  },
];
---

<section class="section wrap" id="work">
  <div class="section-head">
    <h2>Selected work</h2>
    <span class="idx">01 / Work</span>
  </div>
  <div class="work-list">
    {projects.map((project) => (
      <article class="work-card">
        <div class="work-mark">
          <Image
            src={project.image}
            alt={project.alt}
            widths={[168, 336, 500]}
            sizes="(max-width: 719px) min(100vw - 2rem, 520px), 168px"
            format="webp"
          />
        </div>
        <div class="work-body">
          <p class="work-meta">{project.meta}</p>
          <h3>{project.name}</h3>
          <p>{project.body}</p>
          <p class="work-go">
            {project.links.map((link) => (
              <a href={link.href} rel="noopener noreferrer" target="_blank">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </p>
        </div>
      </article>
    ))}
  </div>

  <p class="kicker" style="margin-top: 2.5rem;">Also on GitHub</p>
  <div class="experiments">
    {experiments.map((item) => (
      <a class="exp" href={item.href} rel="noopener noreferrer" target="_blank">
        <strong>{item.name}</strong>
        <span>{item.body}</span>
      </a>
    ))}
  </div>
</section>
