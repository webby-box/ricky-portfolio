<svg class="graph" viewBox="0 0 560 560" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="edge" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#c8f542" stop-opacity="0.05" />
      <stop offset="50%" stop-color="#c8f542" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#c8f542" stop-opacity="0.05" />
    </linearGradient>
  </defs>
  <g fill="none" stroke="url(#edge)" stroke-width="1.2">
    <path class="e" d="M80 120 L210 180 L340 90 L470 160" />
    <path class="e" d="M120 420 L210 180 L390 300 L500 240" />
    <path class="e" d="M60 300 L210 180 L340 90" />
    <path class="e" d="M210 180 L280 430 L430 380" />
    <path class="e" d="M340 90 L390 300 L280 430" />
  </g>
  <g fill="#c8f542">
    <circle class="n" cx="80" cy="120" r="3.2" />
    <circle class="n n2" cx="210" cy="180" r="5" />
    <circle class="n" cx="340" cy="90" r="3.2" />
    <circle class="n n2" cx="470" cy="160" r="3.6" />
    <circle class="n" cx="120" cy="420" r="3" />
    <circle class="n" cx="390" cy="300" r="4" />
    <circle class="n n2" cx="500" cy="240" r="3" />
    <circle class="n" cx="60" cy="300" r="2.6" />
    <circle class="n" cx="280" cy="430" r="3.4" />
    <circle class="n" cx="430" cy="380" r="2.8" />
  </g>
</svg>

<style>
  .e {
    stroke-dasharray: 8 14;
    animation: dash 18s linear infinite;
  }
  .n2 {
    animation: pulse 3.6s ease-in-out infinite;
  }
  @keyframes dash {
    to { stroke-dashoffset: -220; }
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .e, .n2 { animation: none; }
  }
  @media (max-width: 699px) {
    svg { opacity: 0.28; }
  }
</style>
