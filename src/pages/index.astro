---
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo.webp';
import pfp from '../assets/ricky-pfp.webp';
import voyas from '../assets/voyas.webp';
import noozz from '../assets/noozz.webp';
import gitweb from '../assets/gitweb.webp';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const scenes = [
  `${base}bg/glare-bg.gif`,
  `${base}bg/road-bg.gif`,
  `${base}bg/box-bg.gif`,
  `${base}bg/ripple-bg.gif`,
];

const works = [
  { href: 'https://voyas.ai', label: 'Voyas', mark: voyas },
  { href: 'https://noozz.ai', label: 'Noozz', mark: noozz },
  { href: 'https://gitweb.dev', label: 'gitweb', mark: gitweb },
];
---

<Layout>
  <div class="stage">
    <h1 class="sr-only">Ricky Cheuk</h1>

    <button
      class="footage"
      type="button"
      data-cycle
      aria-label="Cycle scene, 1 of 4"
    >
      <img
        class="gif"
        data-bg
        data-scenes={scenes.join('|')}
        src={scenes[0]}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      />
    </button>

    <div class="scrim" aria-hidden="true"></div>

    <img
      class="standee"
      src={pfp.src}
      alt=""
      width="500"
      height="511"
      fetchpriority="high"
    />

    <header class="slate">
      <div class="brand">
        <img class="logo" src={logo.src} alt="" width="22" height="22" />
        <p class="ident">
          <span class="who">Ricky Cheuk</span>
          <span class="dot" aria-hidden="true">·</span>
          <span class="job">SOFTWARE · AI</span>
        </p>
        <span class="idx" data-index>01</span>
      </div>
      <nav class="out" aria-label="Social">
        <a href="https://github.com/rickycheuk" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/rickycheuk/" target="_blank" rel="noreferrer">LinkedIn</a>
      </nav>
    </header>

    <footer class="endcard">
      <p class="line">Big data, smaller interfaces</p>
      <nav class="works" aria-label="Projects">
        {
          works.map((work) => (
            <a class="work" href={work.href} target="_blank" rel="noreferrer">
              <img class="mark" src={work.mark.src} alt="" width="18" height="18" />
              <span>{work.label}</span>
            </a>
          ))
        }
      </nav>
    </footer>
  </div>

  <script>
    const gif = document.querySelector<HTMLImageElement>('[data-bg]');
    const btn = document.querySelector<HTMLButtonElement>('[data-cycle]');
    const idx = document.querySelector('[data-index]');
    if (gif && btn) {
      const list = (gif.dataset.scenes ?? '').split('|').filter(Boolean);
      let i = 0;
      btn.addEventListener('click', () => {
        i = (i + 1) % list.length;
        gif.src = list[i];
        if (idx) idx.textContent = String(i + 1).padStart(2, '0');
        btn.setAttribute('aria-label', `Cycle scene, ${i + 1} of ${list.length}`);
      });
    }
  </script>
</Layout>
