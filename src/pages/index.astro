---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import world from '../assets/art/world.png';
import portrait from '../assets/ricky-pfp.webp';
---

<Layout>
  <div class="stage">
    <div class="grain" aria-hidden="true"></div>

    <header class="mast">
      <nav class="works" aria-label="Projects">
        <a href="https://voyas.ai" target="_blank" rel="noreferrer">Voyas</a>
        <a href="https://noozz.ai" target="_blank" rel="noreferrer">Noozz</a>
        <a href="https://gitweb.dev" target="_blank" rel="noreferrer">gitweb</a>
      </nav>

      <div class="brand">
        <p class="wordmark" aria-hidden="true">Ricky Cheuk</p>
      </div>

      <nav class="social" aria-label="Social">
        <a href="https://github.com/rickycheuk" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/rickycheuk/" target="_blank" rel="noreferrer">LinkedIn</a>
      </nav>
    </header>

    <div class="copy">
      <h1 class="headline">Ricky Cheuk</h1>
      <p class="role">software · AI</p>
    </div>

    <div class="world" aria-hidden="true">
      <Image
        class="world-img"
        src={world}
        alt=""
        widths={[720, 1080, 1536, 2160]}
        sizes="100vw"
        quality={82}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="standee-wrap" aria-hidden="true">
      <Image
        class="standee"
        src={portrait}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(min-width: 720px) 36vw, 70vw"
        quality={84}
        loading="eager"
      />
    </div>
  </div>
</Layout>
