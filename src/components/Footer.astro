---
const year = new Date().getFullYear();
---

<section class="section wrap" id="contact">
  <div class="section-head">
    <h2>Contact</h2>
    <span class="idx">04 / Out</span>
  </div>
  <p style="max-width: 38ch; font-size: 1.2rem; margin: 0;">
    GitHub and LinkedIn are the doors. That’s the whole list.
  </p>
  <div class="contact-row">
    <a
      class="btn btn-primary"
      href="https://github.com/rickycheuk"
      rel="noopener noreferrer"
      target="_blank"
    >
      GitHub <span class="arrow" aria-hidden="true">↗</span>
    </a>
    <a
      class="btn btn-ghost"
      href="https://www.linkedin.com/in/rickycheuk/"
      rel="noopener noreferrer"
      target="_blank"
    >
      LinkedIn <span class="arrow" aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<footer class="footer">
  <div class="footer-inner wrap">
    <p>© {year} Ricky Cheuk</p>
    <nav aria-label="Footer">
      <a href="https://github.com/rickycheuk" rel="noopener noreferrer" target="_blank">GitHub</a>
      &nbsp;·&nbsp;
      <a href="https://www.linkedin.com/in/rickycheuk/" rel="noopener noreferrer" target="_blank">LinkedIn</a>
    </nav>
  </div>
</footer>
