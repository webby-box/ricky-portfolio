---
const year = new Date().getFullYear();
---

<footer class="footer" id="contact">
  <div class="ticket">
    <div class="ticket-top">
      <span class="ticket-admit">Admit one</span>
      <span>Nº {year}</span>
    </div>
    <h2>Ricky Cheuk</h2>
    <p class="ticket-role">software engineer · AI</p>
    <div class="ticket-bar" aria-hidden="true"></div>
    <p class="ticket-role" style="margin-top:0">
      GitHub and LinkedIn are the doors. That’s the whole list.
    </p>
    <div class="ticket-links">
      <a href="https://github.com/rickycheuk" rel="noopener noreferrer" target="_blank">
        GitHub ↗
      </a>
      <a href="https://www.linkedin.com/in/rickycheuk/" rel="noopener noreferrer" target="_blank">
        LinkedIn ↗
      </a>
    </div>
    <p class="ticket-copy">© {year} Ricky Cheuk</p>
  </div>
</footer>
